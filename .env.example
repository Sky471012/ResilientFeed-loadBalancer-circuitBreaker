# =====================================================================
# ResilientFeed - copy this file to .env and adjust if needed
#   copy .env.example .env      (PowerShell: Copy-Item .env.example .env)
# =====================================================================

# --- Infrastructure ---------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/resilient_feed
REDIS_URL=redis://127.0.0.1:6379

# --- Circuit breaker tuning ------------------------------------------
FAILURE_THRESHOLD=3
SUCCESS_THRESHOLD=2
OPEN_TIMEOUT_MS=10000
HALF_OPEN_MAX_REQUESTS=1
# Set to false to see what happens WITHOUT circuit breakers (Experiment 7)
CIRCUIT_BREAKER_ENABLED=true
# Timeout for one downstream HTTP call (Feed -> Post/Profile, Post -> Profile)
DOWNSTREAM_TIMEOUT_MS=3000

# --- Profile Service (:7000) ------------------------------------------
PROFILE_PORT=7000
PROFILE_FAIL=false
PROFILE_DELAY_MS=0

# --- Post Service (:7001) ---------------------------------------------
POST_PORT=7001
POST_FAIL=false
POST_DELAY_MS=0
PROFILE_SERVICE_URL=http://localhost:7000

# --- Feed Service (instances set PORT themselves) ---------------------
FEED_PORT=7004
FEED_PROFILE_SERVICE_URL=http://localhost:7000
FEED_POST_SERVICE_URL=http://localhost:7001

# --- Load Balancer (:8000) --------------------------------------------
LB_PORT=8000
FEED_TARGETS=http://localhost:7004,http://localhost:7005,http://localhost:7006
LB_HEALTH_PROBE_MS=3000
UPSTREAM_TIMEOUT_MS=8000
